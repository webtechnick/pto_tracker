APP_NAME=PTO_Tracker
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_LEVEL=debug

APP_DEPARTMENT="IT"

ALWAYS_ON_CALL_NAME="Some Name"
ALWAYS_ON_CALL_NUMBER="(123) 456-7890"

TAG_MODEL=App\Tag

# Bare host name, no port ("localhost:8000" breaks the cookie -> 419 errors).
SESSION_DOMAIN="localhost"

# Docker stack: DB_DATABASE must be the absolute in-container path.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/database/database.sqlite

# Laravel 6 names (BROADCAST_DRIVER, CACHE_DRIVER, QUEUE_DRIVER, MAIL_DRIVER,
# MAIL_ENCRYPTION, APP_LOG_LEVEL) are still read as fallbacks.
BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
# Port 465 uses implicit TLS, other ports STARTTLS when offered. Force with:
# MAIL_SCHEME=smtps
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="PTO Tracker"

GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/login/google/callback
GOOGLE_DOMAIN=example.com

# API (shared token for dora-metrics integration)
API_TOKEN=

# Production Server (Teleport)
PROD_USERNAME=your_username
PROD_HOST=your-server.example.com
